--- !u!114 &5668733212539148866
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1903431738898963800}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b8e2c72d6f269814fae899ad9e205d21, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ShipCoopTutorialView
  game: {fileID: 0}
  panel: {fileID: 5934810812183817024}
  bodyLabel: {fileID: 518389090168685654}
  footerLabel: {fileID: 7313764883772966463}
  body: "\uB137\uC774\uC11C \uBC30 \uD55C \uCC99\uC744 \uBAB9\uB2C8\uB2E4. 3\uBD84
    \uC548\uC5D0 \uBAA9\uC801\uC9C0\uAE4C\uC9C0.\n\n\uCCB4\uB825\uC740 \uB137\uC774
    \uB098\uB220 \uC4F0\uB294 \uD558\uB098\uBFD0\uC785\uB2C8\uB2E4.\n\uAC00\uB77C\uC549\uC544\uB3C4
    \uB05D\uC774\uACE0, \uB2A6\uC5B4\uB3C4 \uB05D\uC785\uB2C8\uB2E4.\n\n   \uB3DB\uC744
    \uD3B4\uC57C \uBC30\uAC00 \uB098\uC544\uAC00\uACE0\n   \uC870\uD0C0\uB97C \uC7A1\uC544\uC57C
    \uC554\uCD08\uB97C \uD53C\uD558\uACE0\n   \uB300\uD3EC\uB85C \uB2E4\uAC00\uC624\uB294
    \uC801\uC120\uC744 \uB9C9\uACE0\n   \uAD6C\uBA4D\uC740 \uD310\uC790\uB85C \uB9C9\uACE0,
    \uCC28\uC624\uB978 \uBB3C\uC740 \uD37C\uB0C5\uB2C8\uB2E4\n\n\uC218\uB9AC\uC640
    \uB300\uD3EC, \uBC30\uC218\uB294 \uC0C1\uC790\uC5D0\uC11C \uD544\uC694\uD55C
    \uBB3C\uAC74\uC744 \uB0A0\uB77C \uC640\uC57C \uD569\uB2C8\uB2E4.\n\uBB34\uC5B8\uAC00\uB97C
    \uB4E4\uACE0 \uC788\uB294 \uB3D9\uC548\uC5D0\uB294 \uB2E4\uB978 \uC77C\uC744
    \uBABB \uD569\uB2C8\uB2E4.\n\n\uB9E1\uC740 \uC790\uB9AC\uB294 \uC5C6\uC2B5\uB2C8\uB2E4.
    \uBE44\uC5B4 \uC788\uB294 \uC790\uB9AC\uB97C \uC11C\uB85C \uBA54\uC6B0\uC138\uC694."
  footerFormat: "{0}\uCD08 \uD6C4 \uC790\uB3D9\uC73C\uB85C \uB2EB\uD799\uB2C8\uB2E4."
  autoHideSeconds: 10
