# ============================================================
# UnderTheSea .gitattributes
#
# 이 파일은 두 가지를 담당합니다.
#
#   1) 줄바꿈(엔터) 형식 통일
#      → 아무것도 안 고쳤는데 "수정됨"으로 뜨는 문제와
#         씬/프리팹 병합 충돌을 막습니다.
#
#   2) 큰 파일을 Git LFS로 보내기
#      → 이미지, 3D 모델, 오디오는 저장소에 직접 넣지 않고
#         LFS 저장 공간에 보관합니다.
#
# 저장소 최상위에 있으므로 unity/, iot/, server/ 전부에 적용됩니다.
#
# 새 확장자를 추가할 때는 팀에 공유한 뒤 수정합니다.
# ============================================================


# ------------------------------------------------------------
# 기본값
# ------------------------------------------------------------
# 텍스트 파일을 자동으로 판별하고 저장소에는 LF로 통일해서 저장합니다.
* text=auto


# ------------------------------------------------------------
# Unity 텍스트 파일 — 반드시 LF 고정
#
# ⚠ 아래 확장자는 절대 LFS에 넣지 마세요.
#   LFS에 넣으면 변경 내역 비교와 병합이 불가능해집니다.
# ------------------------------------------------------------
*.cs                 text eol=lf diff=csharp
*.unity              text eol=lf
*.prefab             text eol=lf
*.mat                text eol=lf
*.asset              text eol=lf
*.meta               text eol=lf
*.anim               text eol=lf
*.controller         text eol=lf
*.overrideController text eol=lf
*.mask               text eol=lf
*.playable           text eol=lf
*.signal             text eol=lf
*.physicMaterial     text eol=lf
*.physicsMaterial2D  text eol=lf
*.preset             text eol=lf
*.terrainlayer       text eol=lf
*.mixer              text eol=lf
*.guiskin            text eol=lf
*.flare              text eol=lf
*.lighting           text eol=lf
*.shadervariants     text eol=lf
*.spriteatlas        text eol=lf
*.spriteatlasv2      text eol=lf

# ------------------------------------------------------------
# ⚠ 예외 — TerrainData 는 바이너리입니다
#
# 터레인 데이터는 m_SerializationMode 가 ForceText(2) 여도
# 바이너리로 저장됩니다. 위의 *.asset text 규칙이 걸리면
# git 이 줄바꿈을 정규화하며 바이너리를 훼손하고,
# Unity 가 "Unknown error occurred while loading" 을 냅니다.
# (실제로 6,148,220 → 6,148,212 바이트로 8바이트가 소실됨)
#
# 터레인 에셋은 반드시 Terrain_*.asset 으로 이름을 짓습니다.
# ------------------------------------------------------------
Terrain_*.asset      -text filter=lfs diff=lfs merge=lfs

# 셰이더
*.shader             text eol=lf
*.cginc              text eol=lf
*.hlsl               text eol=lf
*.compute            text eol=lf
*.raytrace           text eol=lf

# 설정 / 문서
*.json               text eol=lf
*.inputactions       text eol=lf
*.asmdef             text eol=lf
*.asmref             text eol=lf
*.uxml               text eol=lf
*.uss                text eol=lf
*.md                 text eol=lf
*.txt                text eol=lf
*.xml                text eol=lf
*.yml                text eol=lf
*.yaml               text eol=lf
.gitattributes       text eol=lf
.gitignore           text eol=lf


# ------------------------------------------------------------
# 실행 스크립트 — 각 OS 형식 유지
# ------------------------------------------------------------
*.bat                text eol=crlf
*.cmd                text eol=crlf
*.ps1                text eol=crlf
*.sh                 text eol=lf


# ------------------------------------------------------------
# Git LFS — 이미지
# ------------------------------------------------------------
*.png    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
*.jpeg   filter=lfs diff=lfs merge=lfs -text
*.gif    filter=lfs diff=lfs merge=lfs -text
*.bmp    filter=lfs diff=lfs merge=lfs -text
*.tga    filter=lfs diff=lfs merge=lfs -text
*.tif    filter=lfs diff=lfs merge=lfs -text
*.tiff   filter=lfs diff=lfs merge=lfs -text
*.psd    filter=lfs diff=lfs merge=lfs -text
*.exr    filter=lfs diff=lfs merge=lfs -text
*.hdr    filter=lfs diff=lfs merge=lfs -text
*.dds    filter=lfs diff=lfs merge=lfs -text
*.iff    filter=lfs diff=lfs merge=lfs -text
*.pict   filter=lfs diff=lfs merge=lfs -text


