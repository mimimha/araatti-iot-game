<Project Sdk="Microsoft.NET.Sdk">

  <!--
    AraAtti.Api 의 통합 테스트. 실행: server/ 에서  dotnet test AraAtti.Api.Tests

    ⚠ API 폴더(AraAtti.Api/) 바깥에 둔다. 안에 두면 API 프로젝트가 이 폴더의 .cs 까지
      같이 컴파일한다. 배포(dotnet publish AraAtti.Api.csproj)에는 따라가지 않는다.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AraAtti.Api\AraAtti.Api.csproj" />
  </ItemGroup>

</Project>
