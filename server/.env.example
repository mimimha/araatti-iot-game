# docker-compose.yml 이 읽는 값들.
#
# 사용법
#   cp .env.example .env
# 그리고 아래 비밀번호를 직접 바꿉니다. .env 는 커밋되지 않습니다.
#
# ⚠ 개발용 로컬 DB 전용입니다. 실제 배포용 비밀번호를 여기에 적지 않습니다.

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=araatti
MYSQL_USER=araatti
MYSQL_PASSWORD=change-me

# 호스트에서 쓸 포트. 3306 이 이미 쓰이고 있으면 3307 등으로 바꿉니다.
MYSQL_PORT=3306
