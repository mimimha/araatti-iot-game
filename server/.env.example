# docker-compose.yml 이 읽는 값들.
#
# 사용법
#   cp .env.example .env
# 그리고 아래 비밀번호를 직접 바꿉니다. .env 는 커밋되지 않습니다.
#
# ⚠ 개발용 로컬 DB 전용입니다. 실제 배포용 비밀번호를 여기에 적지 않습니다.

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=araatti
MYSQL_USER=araatti
MYSQL_PASSWORD=change-me

# 호스트에서 쓸 포트. 3306 이 이미 쓰이고 있으면 3307 등으로 바꿉니다.
MYSQL_PORT=3306

# DB 를 어느 주소에 묶을지. 기본은 이 machine 안에서만 보이는 127.0.0.1 입니다.
# 다른 PC 에서 붙어야 할 때만 0.0.0.0 으로 바꿉니다.
#
# ⚠ 인터넷에 노출된 서버에서는 절대 0.0.0.0 으로 두지 않습니다. Docker 가 넣는
#    포트 규칙은 UFW 를 지나치므로 방화벽이 막아 주지 못합니다.
MYSQL_BIND=127.0.0.1
